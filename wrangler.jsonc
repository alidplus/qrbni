{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top-level = preview (main branch). Production via --env production (git tags).
  "name": "qrbni-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "preview.qrbni.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "NOCODB_BASE_URL": "https://app.nocodb.com"
  },
  "env": {
    "production": {
      "name": "qrbni",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "qrbni.dev",
          "custom_domain": true
        }
      ],
      "vars": {
        "NOCODB_BASE_URL": "https://app.nocodb.com"
      }
    }
  }
  // Add KV/R2 ISR bindings when enabling on-demand revalidation at scale.
}
