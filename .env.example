# Copy to .env.local (never commit real values)
# CI: same app keys as GitHub secrets; see docs/ARCHITECTURE.md §11

# NocoDB
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Turnstile (TURNSTILE_SECRET preferred; TURNSTILE_SECRET_KEY accepted as fallback)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional: OpenAPI URL for `npm run codegen` (base swagger after tables exist)
# NOCODB_OPENAPI_URL=

# On-demand ISR (openssl rand -hex 32)
REVALIDATE_SECRET=

# Telegram notify — production Worker only (never preview/local)
# GitHub secrets + wrangler secret bulk --env production
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wrangler / GitHub Actions deploy
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
