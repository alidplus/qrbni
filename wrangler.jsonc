{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrbni",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Preview: preview.qrbni.dev · Prod: qrbni.dev (custom domains in CF dashboard / CI)
  // Add KV/R2 ISR bindings when enabling on-demand revalidation at scale.
}
