# Copy to .env.local (never commit real values)

# NocoDB
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Turnstile (secret: TURNSTILE_SECRET preferred; TURNSTILE_SECRET_KEY accepted as fallback)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# On-demand ISR (openssl rand -hex 32)
REVALIDATE_SECRET=

