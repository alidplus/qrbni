{
  "name": "qrbni",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "codegen": "openapi-ts",
    "nocodb:schema": "node scripts/nocodb/bootstrap-schema.mjs",
    "nocodb:seed": "node scripts/nocodb/seed.mjs",
    "nocodb:openapi": "node scripts/nocodb/generate-openapi.mjs",
    "nocodb:sdk": "npm run nocodb:openapi && npm run codegen"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "js-yaml": "^5.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.117.0"
  }
}
